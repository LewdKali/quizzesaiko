<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1a1520">
  <link rel="icon" href="/img/logo.png" type="image/png">
  <title><%= title %> · Quizzes da Aiko</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <a class="header__brand" href="/" aria-label="Quizzes da Aiko">
      <img class="header__logo" src="/img/logo.png" alt="Quizzes da Aiko" width="56" height="56">
    </a>
  </header>
  <main class="main">
    <div class="error-box">
      <h1>Ops</h1>
      <p><%= message %></p>
      <a class="btn btn--pink" href="/">Voltar ao início</a>
    </div>
  </main>
</body>
</html>
